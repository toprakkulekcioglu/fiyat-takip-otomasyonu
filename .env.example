# Bu dosyayı .env olarak kopyala ve gerçek değerlerini gir.
# .env asla git'e eklenmez (.gitignore'da).

# --- E-posta (SMTP) ---
# Gmail kullanıyorsan: normal şifren değil, "Uygulama Şifresi" (App Password) gerekir.
# Google Hesabı -> Güvenlik -> 2 Adımlı Doğrulama (açık olmalı) -> Uygulama Şifreleri
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ornek@gmail.com
SMTP_PASSWORD=uygulama-sifresi-buraya
NOTIFY_EMAIL_FROM=ornek@gmail.com
NOTIFY_EMAIL_TO=ornek@gmail.com

# --- WhatsApp (CallMeBot) ---
# CallMeBot'un botu zaman zaman "dolu" oluyor, yeni kayıt kabul etmeyebilir.
# İkisi de opsiyonel - biri veya ikisi de boş bırakılırsa o kanal sessizce atlanır.
# 1. Telefonunda +34 644 59 71 67 numarasını rehbere ekle
# 2. O numaraya WhatsApp'tan "I allow callmebot to send me messages" yaz
# 3. Gelen cevapta bir API key göreceksin, onu aşağıya yapıştır
CALLMEBOT_PHONE=+905xxxxxxxxx
CALLMEBOT_APIKEY=123456

# --- Telegram (CallMeBot'a alternatif, kapasite sorunu yok) ---
# 1. Telegram'da @BotFather ile sohbet aç, /newbot yaz, isim/kullanıcı adı ver
# 2. BotFather sana bir token verecek (örn. 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
# 3. Oluşturduğun bota Telegram'dan herhangi bir mesaj at (örn. /start)
# 4. Tarayıcıda şu adresi aç: https://api.telegram.org/bot<TOKEN>/getUpdates
#    Dönen JSON'da "chat":{"id":123456789,...} kısmındaki id senin chat_id'in
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=123456789
